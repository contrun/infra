xkb_keymap {
    xkb_keycodes {
        include "win+aliases(qwerty)"
    };

    xkb_types {
        include "complete"
    };

    xkb_compat {
        include "complete"
    };

    xkb_symbols {
        include "pc+us+inet(evdev)"

        key <LWIN> {
            symbols[Group1] = [ NoSymbol ],
            actions[Group1] = [ SetMods(modifiers=Mod1+Mod4) ]
        };
    };

    xkb_geometry {
        include "pc(pc105)"
    };
};
